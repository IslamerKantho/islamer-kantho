# Sanity CMS Configuration (Leave project ID empty to run with built-in Bengali fallback data)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2023-05-03

# Server-Only Sanity API Token (Required only for draft preview mode)
SANITY_API_TOKEN=your-sanity-read-token

# Server-Only Sanity Webhook Secret for On-Demand Cache Revalidation (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX